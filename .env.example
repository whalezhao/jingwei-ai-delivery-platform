# 复制成 .env 再改：cp .env.example .env
# docker compose 自动读取本文件；容器里的 pydantic 也从这些 VEGA_* 变量取值。

### 数据库地址（必填；密码别用 @ : / 之类的 URL 特殊字符）
### 默认复用 内网主机 上现成的 PG（aster-qa 实例）：先按部署手册建 vega 库/角色
VEGA_DATABASE_URL=postgresql+asyncpg://vega:{{(db-password)}}@127.0.0.1:5432/vega
### 改用 compose 内置 PG：把上面改成 ...@db:5432/vega，取消下一行注释，启动时加 --profile bundled-db
# POSTGRES_PASSWORD={{(db-password)}}

### 必改：登录 token 签名 + 落库密钥（gitlab/llm/octo key 的 Fernet 主密钥）。
### 换掉之后，库里已加密的 token 全部解不开，只能重新录入。
VEGA_SECRET_KEY=change-me-long-random-string

### 平台管理员（首次启动自动创建；之后改这里不会重置已存在账号）
VEGA_ADMIN_USERNAME=admin
VEGA_ADMIN_PASSWORD=change-me

### 对外可访问的基地址：集成中心展示、GitLab webhook 注册都用它拼 /webhooks/gitlab。
### 部署时填 GitLab 能访问到的地址（如 https://xxx.ngrok-free.dev），默认只适合本机。
VEGA_API_URL=http://127.0.0.1:8181

### agent-memory（所有 LLM 流量的统一出口）
VEGA_AM_BASE_URL=http://127.0.0.1:8096
VEGA_AM_HUB_BASE_URL=http://127.0.0.1:8125
VEGA_AM_SPACE_ID=default
VEGA_AM_USER_KEY=
VEGA_AM_DEFAULT_MODEL=Qwen3.8-27B
VEGA_AM_DEFAULT_EFFORT=xhigh

### octo 群通知（留空 = 通知只记库不外发）
### bot token 建议在「集成中心」录入（生效优先于这里）；地址留空走默认值
VEGA_OCTO_API_URL=https://octo.example.com
VEGA_OCTO_BOT_TOKEN=

### CRG 代码图谱的向量嵌入服务
VEGA_CRG_EMBEDDING_BASE_URL=http://127.0.0.1:18083/v1
VEGA_CRG_EMBEDDING_MODEL=qwen3-embedding-0.6b-q8_0.gguf
VEGA_CRG_EMBEDDING_API_KEY=local

### runner（docker compose --profile runner 启动时用；token 在界面创建节点后发放）
VEGA_RUNNER_NAME=vega-runner-1
VEGA_RUNNER_TOKEN=

### 或者用现成 SQLite 文件（替代上面的 PG；vega.db 放到 ./data/）
# VEGA_DATABASE_URL=sqlite+aiosqlite:////data/vega.db

### 镜像构建源（默认国内镜像；海外网络可改回官方源）
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
NPM_REGISTRY=https://registry.npmmirror.com
APT_MIRROR=mirrors.tuna.tsinghua.edu.cn
### jdtls 默认从 download.eclipse.org 拉，国内直连很慢，可改成本地缓存地址
# JDTLS_URL=http://127.0.0.1:18099/jdtls.tar.gz
