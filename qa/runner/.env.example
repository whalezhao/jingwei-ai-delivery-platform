# midscene 执行器的**非模型**配置。
#
# 这里故意不放大模型配置。模型（模型名 / 接入地址 / API Key）由平台按项目指定，
# 存在数据库的 project_model_configs 表里，执行时由后端注入子进程环境变量。
#
# 为什么不给全局兜底：一个项目的用例跑在哪个模型上必须是个明确的决定，
# 静默继承会让这件事变成没人知道的状态。项目没配好模型就不允许执行。

MIDSCENE_CACHE=1
MIDSCENE_PREFERRED_LANGUAGE=Chinese
HEADLESS=true

# 平台每次执行会覆盖成 run 私有目录，这里留个占位
MIDSCENE_RUN_DIR=midscene_run
